PORT=3001

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
POSTGRES_USER=postgres
PGPASSWORD=YOUR_PASSWORD
POSTGRES_DB=YOUR_DATABASE_NAME
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE_NAME

TYPEORM_SYNC=false

BCRYPT_SALT_ROUNDS=12
ACCESS_TOKEN_SECRET=change_me_access_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=change_me_refresh_secret
REFRESH_TOKEN_EXPIRY=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/your_cloud_name/image/upload

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
# Optional extra origins (comma-separated), e.g. preview deploys
# CORS_ORIGINS=https://your-preview.vercel.app
