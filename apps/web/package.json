{
  "name": "@repo/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#components/auth/hooks/*": "./src/components/auth/hooks/*.ts",
    "#components/product/hooks/*": "./src/components/product/hooks/*.ts",
    "#components/category/hooks/*": "./src/components/category/hooks/*.ts",
    "#components/cart/hooks/*": "./src/components/cart/hooks/*.ts",
    "#components/address/hooks/*": "./src/components/address/hooks/*.ts",
    "#components/orders/hooks/*": "./src/components/orders/hooks/*.ts",
    "#contexts/*": "./src/contexts/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#layouts/*": "./src/layouts/*.tsx",
    "#lib/mock-data": "./src/lib/mock-data/index.ts",
    "#lib/types": "./src/lib/types/index.ts",
    "#lib/mappers/*": "./src/lib/mappers/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#pages/*": "./src/pages/*.tsx",
    "#pages/admin/*": "./src/pages/admin/*.tsx",
    "#routes/*": "./src/routes/*.tsx",
    "#api/*": "./src/api/*.ts",
    "#api/services/*": "./src/api/services/*.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@repo/contracts": "workspace:*",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "recharts": "3.8.0",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
